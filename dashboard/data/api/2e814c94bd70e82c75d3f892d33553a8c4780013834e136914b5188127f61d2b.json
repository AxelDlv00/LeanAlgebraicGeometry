{"nodes": [{"id": "thmmain", "type": "theorem", "title": "geometric Bogomolov conjecture", "chapter": "Introduction", "group": "ch:Introduction", "level": "medium", "order": 2, "statement": "Let $k$ be an algebraically closed field.\nLet $K/k$ be a finitely generated field extension of transcendence degree at least 1.\nLet $A$ be an abelian variety over $K$. \nLet $X$ be a closed subvariety of $A_{\\overline{K}}$. \nIf $X$ contains a dense set of small points of $A/K/k$, then $X$ is special.", "uses": [], "sources": ["geometric-bogomolov-conjecture-arbitrary-characteristics"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "5e4387e9f0b5"}, {"id": "line bundle", "type": "lemma", "title": "line bundle", "chapter": "Line bundles over abelian schemes", "group": "ch:Line bundles over abelian schemes", "level": "medium", "order": 7, "statement": "Let $\\sL$ be a rigidified line bundle over $\\sA$. \nThen the following hold.\n\\begin{itemize}\n\\item[(1)] If $\\sL$ is symmetric, then $[m]^*\\sL\\simeq m^2\\sL$ for any $m\\in \\Z$; if $\\sL$ is anti-symmetric, then $[m]^*\\sL\\simeq m\\sL$ for any $m\\in \\Z$.\n\\item[(2)] For any torsion multi-section $\\sT\\subset \\sA$, the line bundle $\\sL|_{\\sT}$ is torsion in $\\Pic(\\sT)$.\n\\item[(3)] If $\\sL$ is symmetric and $\\pi$-ample, then $\\sL$ is nef over $\\sA$. \n\\item[(4)] If $\\sL$ is symmetric and $\\pi$-ample, and $\\sL'$ is another symmetric and rigidified line bundle over $\\sA$, then there is a positive integer $a$ such that $a\\sL-\\sL'$ is nef over $\\sA$. \n\\end{itemize}", "uses": [], "sources": ["geometric-bogomolov-conjecture-arbitrary-characteristics"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "b0f9ef11c985"}, {"id": "cordeffield", "type": "corollary", "title": "cordeffield", "chapter": "Lowering the transcendence degree", "group": "ch:Lowering the transcendence degree", "level": "fine", "order": 5, "statement": "Let $K/k$ be an extension of algebraically closed fields. \n\\begin{points}\n\\item Let $A$ be an abelian variety over $K.$\nThen there is an algebraically closed intermediate field $k_A$ of $K/k$, such that for every algebraically closed intermediate field $k'$ of $K/k$, \n$A$ is defined over $k'$ up to isogeny if and only if $k_A\\subseteq k'.$\nMoreover, we have $\\trdeg(k_A/k)<\\infty.$\n\\item Let $Y$ be a variety over $k$. Let $X$ be a subvariety of $Y_K=Y\\otimes_kK.$\nThen there is an algebraically closed intermediate field $k_{X\\subseteq Y_K}$ of $K/k$, such that for every algebraically closed intermediate field $k'$ of $K/k$,\n$X\\subseteq Y_K$ is defined over $k'$ if and only if $k_{X\\subseteq Y_K}\\subseteq k'.$\nMoreover, we have $\\trdeg(k_{X\\subseteq Y_K}/k)<\\infty.$\n\\end{points}", "uses": [], "sources": ["geometric-bogomolov-conjecture-arbitrary-characteristics"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "1a722002968b"}, {"id": "MM", "type": "theorem", "title": "Manin--Mumford conjecture", "chapter": "Proof of the geometric Bogomolov conjecture", "group": "ch:Proof of the geometric Bogomolov conjecture", "level": "medium", "order": 9, "statement": "Let $K$ be a finitely generated field over an algebraically closed field $k$. Let $A$ be an abelian variety over $K$ of trivial $\\overline K/ k$-trace.\nLet $X$ be a closed subvariety of $A_{\\overline K}$. \nAssume that $X(\\overline K)\\cap A(\\overline K)_\\tor$ is Zariski dense in $X$. \nThen $X$ is a torsion subvariety of $A_{\\overline K}$.", "uses": [], "sources": ["geometric-bogomolov-conjecture-arbitrary-characteristics"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "4483d0b29ced"}], "edges": [], "dangling": [], "meta": {"engine": "hgraph", "entry": "/home/axel/LeanAlgebraicGeometry-Horizon/FormalizedPapers/ArithmeticGeometry/GeometricBogomolovConjectureArbitraryCharacteristics/blueprint/src/content.tex", "macros": {"\\SH": "\\rm SH", "\\Tan": "\\rm Tan", "\\res": "\\rm res", "\\Om": "\\Omega", "\\om": "\\omega", "\\la": "\\lambda", "\\mc": "\\mathcal", "\\mb": "\\mathbb", "\\surj": "\\twoheadrightarrow", "\\inj": "\\hookrightarrow", "\\zar": "{\\rm zar}", "\\Exc": "{\\rm Exc}", "\\an": "{\\rm an}", "\\red": "{\\rm red}", "\\codim": "{\\rm codim}", "\\Supp": "{\\rm Supp}", "\\rank": "{\\rm rank}", "\\Ker": "{\\rm Ker \\ }", "\\Pic": "\\operatorname{Pic}", "\\Der": "{\\rm Der}", "\\Div": "{\\rm Div}", "\\Hom": "\\operatorname{Hom}", "\\im": "{\\rm im}", "\\Spec": "\\operatorname{Spec}", "\\Nef": "{\\rm Nef \\,}", "\\Frac": "{\\rm Frac \\,}", "\\Sing": "{\\rm Sing}", "\\sing": "{\\rm sing}", "\\reg": "{\\rm reg}", "\\Char": "{\\rm char\\,}", "\\Tr": "{\\rm Tr}", "\\ord": "{\\rm ord}", "\\id": "{\\rm id}", "\\NE": "{\\rm NE}", "\\Gal": "{\\rm Gal}", "\\Min": "{\\rm Min \\ }", "\\Max": "{\\rm Max \\ }", "\\Alb": "{\\rm Alb}\\,", "\\GL": "\\operatorname{GL}", "\\PGL": "{\\rm PGL}\\,", "\\Bir": "{\\rm Bir}", "\\Aut": "{\\rm Aut}", "\\End": "\\operatorname{End}", "\\Per": "{\\rm Per}\\,", "\\ie": "{\\it i.e.\\/},\\ ", "\\niso": "\\not\\cong", "\\nin": "\\not\\in", "\\soplus": "\\stackrel{#1}{\\oplus}", "\\by": "\\st