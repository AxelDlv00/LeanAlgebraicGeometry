{"nodes": [{"id": "mine", "type": "theorem", "title": "Thm. 1.1 of \\cite{L}", "chapter": "Existence", "group": "ch:Existence", "level": "medium", "order": 7, "statement": "If $E$ is a vector bundle on $\\pi: B \\times \\pp^1 \\rightarrow B$ and $\\codim \\Sigmabar_{\\vec{e}}(E) = u(\\vec{e})$, then the class $[\\Sigmabar_{\\vec{e}}(E)]$ is given by a universal formula in terms of Chern classes $\\pi_* E(m)$ and $\\pi_*E(m-1)$ for suitably large $m$. Moreover, if this expected class is non-zero, then $\\Sigmabar_{\\vec{e}}(E)$ is non-empty.", "uses": [], "sources": ["refined-brill-noether-theory-hurwitz-spaces"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "40eb62dd2c14"}, {"id": "main", "type": "theorem", "title": "main", "chapter": "Introduction", "group": "ch:Introduction", "level": "medium", "order": 2, "statement": "Let $f\\colon  C \\rightarrow \\pp^1$ be a general degree $k$, genus $g$ cover.\nLet $d$ be any integer and let $\\vec{e} = (e_1, \\ldots, e_k)$ be a collection of integers with $e_1 + \\ldots + e_k = d - g - k + 1$.\nIf $u(\\vec{e}) \\leq g$, then $\\Sigma_{\\vec{e}}(C, f)$ is smooth of pure dimension $g - u(\\vec{e})$. If $u(\\vec{e}) > g$ then $\\Sigma_{\\vec{e}}(C, f)$ is empty.", "uses": [], "sources": ["refined-brill-noether-theory-hurwitz-spaces"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "6e169f5ed980"}], "edges": [], "dangling": [], "meta": {"engine": "hgraph", "entry": "/home/axel/LeanAlgebraicGeometry-Horizon/FormalizedPapers/CurvesAndLinearSeries/RefinedBrillNoetherTheo