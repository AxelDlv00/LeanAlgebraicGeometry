{"nodes": [{"id": "generic-green", "type": "theorem", "title": "generic-green", "chapter": "Introduction", "group": "ch:Introduction", "level": "medium", "order": 2, "statement": "Let $C$ be a general curve over $\\C$ of genus $g=2k$ or $g=2k+1$. Then $\\mathrm{K}_{k,1}(C,\\omega_C)=0$.", "uses": [], "sources": ["universal-secant-bundles-syzygies-canonical-curves"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "52a953121b52"}, {"id": "geo-thm-intro", "type": "theorem", "title": "geo-thm-intro", "chapter": "Introduction", "group": "ch:Introduction", "level": "medium", "order": 3, "statement": "Let $X$ be a complex K3 surface. Assume $\\mathrm{Pic}(X)=\\mathbb{Z}[L]$ with $L$ ample of even genus $g=2k$. Let $E$ be the Lazarsfeld-Mukai bundle as above. For any nonzero $s \\in \\mathrm{H}^0(E)$, the space $\\mathrm{K}_{k-1,1}(X,L,\\mathrm{H}^0(L \\otimes I_{Z(s)}))$ is a one-dimensional subspace of $\\mathrm{K}_{k-1,1}(X,L)$.\nThe morphism\n{\\small{\\begin{align*}\n\\psi \\; : \\; \\PP(\\mathrm{H}^0(E)) & \\to \\PP(\\mathrm{K}_{k-1,1}(X,L))\\\\\n[s] & \\mapsto [\\mathrm{K}_{k-1,1}(X,L,\\mathrm{H}^0(L \\otimes I_{Z(s)}))]\n\\end{align*}}}\nis the Veronese embedding of degree $k-2$. In particular, $\\psi$ induces a natural isomorphism $\\mathrm{Sym}^{k-2}\\mathrm{H}^0(X,E) \\simeq \\mathrm{K}_{k-1,1}(X,L) $.", "uses": [], "sources": ["universal-secant-bundles-syzygies-canonical-curves"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "581c183c321b"}, {"id": "green-quads", "type": "theorem", "title": "\\cite{andreotti-mayer}, \\cite{green-quadrics}", "chapter": "Introduction", "group": "ch:Introduction", "level": "medium", "order": 4, "statement": "The ideal $I_{C/\\PP^{g-1}}$ of a canonical curve of Clifford index at least two is generated by quadrics of rank four.", "uses": [], "sources": ["universal-secant-bundles-syzygies-canonical-curves"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "d26618829426"}, {"id": "geo-cor", "type": "corollary", "title": "Geometric Syzygy Conjecture in Even Genus", "chapter": "Introduction", "group": "ch:Introduction", "level": "fine", "order": 5, "statement": "Let $C$ be a general curve of even genus $g=2k$. Then $\\mathrm{K}_{k-1,1}(C,\\omega_C)$ is generated by syzygies of the lowest possible rank $k$.  More precisely, $\\mathrm{K}_{k-1,1}(C,\\omega_C)$ is generated by the rank $k$ syzygies $$\\alpha \\in \\mathrm{K}_{k-1,1}(C,\\omega_C,\\mathrm{H}^0(\\omega_C \\otimes A^{-1})), \\; \\; A \\in W^1_{k+1}(C).$$", "uses": [], "sources": ["universal-secant-bundles-syzygies-canonical-curves"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "e721541b8028"}, {"id": "real-thm", "type": "theorem", "title": "real-thm", "chapter": "The Geometric Syzygy Conjecture", "group": "ch:The Geometric Syzygy Conjecture", "level": "medium", "order": 10, "statement": "The natural morphism $\\psi: \\mathrm{H}^1(B, \\wedge^k \\pi^* \\mathcal{M} \\otimes {p'}^*L) \\to \\mathrm{H}^1(B, \\wedge^k \\Gamma \\otimes {p'}^*L)$ is surjective.", "uses": [], "sources": ["universal-secant-bundles-syzygies-canonical-curves"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "b312ff37a7c2"}, {"id": "main-cor-nat-iso", "type": "corollary", "title": "main-cor-nat-iso", "chapter": "The Geometric Syzygy Conjecture", "group": "ch:The Geometric Syzygy Conjecture", "level": "fine", "order": 11, "statement": "The morphism $\\psi: \\mathrm{H}^1(\\wedge^k \\pi^* \\mathcal{M} \\otimes {p'}^*L) \\to \\mathrm{H}^1(\\wedge^k \\Gamma \\otimes {p'}^*L)$ is an isomorphism and induces a natural isomorphism $\\mathrm{K}_{k-1,1}(X,L) \\simeq \\mathrm{Sym}^{k-2}\\mathrm{H}^0(X,E)  $.", "uses": [], "sources": ["universal-secant-bundles-syzygies-canonical-curves"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "ee7ff1e04987"}, {"id": "auto-injectivity", "type": "proposition", "title": "auto-injectivity", "chapter": "Voisin's Theorem in Even Genus", "group": "ch:Voisin's Theorem in Even Genus", "level": "medium", "order": 7, "statement": "We have a natural isomorphism $\\mathrm{H}^k(\\mathrm{Sym}^{k+1} \\mathcal{G}) \\xrightarrow{\\sim} \\mathrm{H}^k(\\mathrm{Sym}^{k} \\mathcal{G} \\otimes p^*L \\otimes I_{\\mathcal{Z}}).$", "uses": [], "sources": ["universal-secant-bundles-syzygies-canonical-curves"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "77aae5ad0011"}, {"id": "main-thm", "type": "theorem", "title": "main-thm", "chapter": "Voisin's Theorem in Even Genus", "group": "ch:Voisin's Theorem in Even Genus", "level": "medium", "order": 8, "statement": "We have $\\mathrm{H}^i(B, \\bigwedge^{k+1-i} \\pi^* \\mathcal{M} \\otimes \\mathrm{Sym}^i \\mathcal{S})=0$ for $1 \\leq i \\leq k+1$.", "uses": [], "sources": ["universal-secant-bundles-syzygies-canonical-curves"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "1ec5cdc878fe"}, {"id": "most-of-van", "type": "proposition", "title": "most-of-van", "chapter": "Voisin's Theorem in Odd Genus", "group": "ch:Voisin's Theorem in Odd Genus", "level": "medium", "order": 13, "statement": "We have $\\mathrm{H}^{2+i}(\\bigwedge^{k+2-i} \\pi^* \\mathcal{M} \\otimes \\mathrm{Sym}^i(S) ({p'}^*\\Delta)(D))=0$ for $1 \\leq i \\leq k+2$, $i \\neq k, k+1$.", "uses": [], "sources": ["universal-secant-bundles-syzygies-canonical-curves"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "da2b4aa39923"}, {"id": "green-odd-main", "type": "proposition", "title": "green-odd-main", "chapter": "Voisin's Theorem in Odd Genus", "group": "ch:Voisin's Theorem in Odd Genus", "level": "medium", "order": 14, "statement": "We have $\\mathrm{H}^{k+3}(B,\\pi^* \\mathcal{M} \\otimes \\mathrm{Sym}^{k+1}(S) ({p'}^*\\Delta)(D))=0$.", "uses": [], "sources": ["universal-secant-bundles-syzygies-canonical-curves"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "3ec9f948dcba"}], "edges": [], "dangling": [], "meta": {"engine": "hgraph", "entry": "/home/axel/LeanAlgebraicGeometry-Horizon/FormalizedPapers/CurvesAndLinearSeries/UniversalSecantBundlesSyzygiesCanonicalCurves/blueprint/src/content.tex", "macros": {"\\label": "", "\\source": "", "\\uses": "", "\\lean": "", "\\leanok": "", "\\mathlibok": "", "\\notready": "", "\\Spec": "\\operatorname{Spec}", "\\Pic": "\\operatorname{Pic}", "\\Jac": "\\operatorname{Jac}", "\\GL": "\\operatorname{GL}", "\\Hom": "\\operatorname{Hom}", "\\End": "\\operatorname{End}", "\\C": "\\mathbb{C}", "\\Q": "\\mathbb{Q}", "\\Z": "\\mathbb{Z}", "\\F": "\\mathcal{F}", "\\P": "\\mathbb{P}", "\\A": "\\mathbb{A}", "\\M": "\\mathcal{M}", "\\T": "\\mathbb{G}_m", "\\K": "\\mathcal{K}", "\\proj": "\\mathbb{P}", "\\PROJ": "\\mathbb{P}", "\\seq": "\\subseteq", "\\R": "\\mathbb{R}", "\\CC": "\\mathcal{C}", "\\HH": "\\mathcal{H}", "\\LL": "\\mathcal{L}", "\\mcoarse": "\\overline{M}_{md+1}", "\\msmall": "\\overline{M}_{3}", "\\mfine": "\\overline{M}_{md+1}^{*}", "\\hypsur": "\\mathcal{H}", "\\unihyp": "\\mathfrak{H}", "\\sheafO": "\\mathcal{O}", "\\mcoarsebig": "\\overline{M}_{(md+1)l}", "\\DIAG": "\\bigtriangleup", "\\ISOM": "\\simeq", "\\UN": "\\underline", "\\MAC": "\\mathcal", "\\rank": "\\mathrm{rank }"}, "states": {"closed": 0, "ready": 15, "formalized_open": 0, "blocked": 0, "informal": 15}, "warnings": []}}