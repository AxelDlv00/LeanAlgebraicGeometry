{"nodes": [{"id": "prop41", "type": "proposition", "title": "prop41", "chapter": "Further results", "group": "ch:Further results", "level": "medium", "order": 19, "statement": "Let $a$ be a fixed positive integer.\\\nThe number of deformation types of \\hk\\ manifolds $X$ of fixed dimension $2n$ for which there are classes~$\\lll,\\mm\\in H^2(X,\\Z)$ such that $\\int_X \\lll^{2n}=0$ and $\\int_X \\lll^{n}\\mm^{n}=an!$ is finite.", "uses": [], "sources": ["riemann-roch-polynomials-hyperkahler-fourfolds"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "4f5a92d2c35c"}, {"id": "prop42", "type": "proposition", "title": "prop42", "chapter": "Further results", "group": "ch:Further results", "level": "medium", "order": 20, "statement": "The number of deformation types of  \\hk\\ fourfolds $X$   for which there are classes~$\\lll, \\mm\\in H^2(X,\\Z)$ such that   \\mbox{$\\int_X \\lll^4=0$} and  the   integer $a= \\frac{1}{2}\\int_X \\lll^{2}\\mm^{2}$ is positive and square-free, is finite.", "uses": [], "sources": ["riemann-roch-polynomials-hyperkahler-fourfolds"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "340d74e7e1d0"}, {"id": "prop:SurfacesOnHK4", "type": "proposition", "title": "prop:SurfacesOnHK4", "chapter": "On the SYZ conjecture in dimension 4", "group": "ch:On the SYZ conjecture in dimension 4", "level": "medium", "order": 6, "statement": "A very general triple $(X,\\lll,\\mm)$ satisfying~\\eqref{hypo} has the following properties:\n\\begin{enumerate}[{\\rm (a)}]\n\\item $\\NS(X)=\\Z\\lll\\op \\Z\\mm$;\n\n\\item the group of degree-2 rational Hodge classes is\n\n$$\\Hdg^2(X,\\Q)={\\Sym}^2{\\NS}(X)_{\\Q}\\op\\Q q_X^\\vee=\\Q\\lll^2\\oplus \\Q\\lll\\mm\\op\\Q\\mm^2\\op\\Q q_X^\\vee.$$\n\\end{enumerate}", "uses": [], "sources": ["riemann-roch-polynomials-hyperkahler-fourfolds"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "27e60d502554"}, {"id": "lem:NefCone4folds", "type": "proposition", "title": "lem:NefCone4folds", "chapter": "On the SYZ conjecture in dimension 4", "group": "ch:On the SYZ conjecture in dimension 4", "level": "medium", "order": 7, "statement": "Let $(X,\\lll,\\mm)$ be a triple satisfying~\\eqref{hypo} and such that~$\\NS(X)=\\Z\\lll\\oplus\\Z\\mm$.\\\nThe nef and movable cones of $X$ coincide.\\\nEquivalently, $X$ has no nontrivial \\hk\\ birational models.", "uses": [], "sources": ["riemann-roch-polynomials-hyperkahler-fourfolds"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "e70d222823b2"}, {"id": "prop:CaseC1", "type": "proposition", "title": "prop:CaseC1", "chapter": "On the SYZ conjecture in dimension 4", "group": "ch:On the SYZ conjecture in dimension 4", "level": "medium", "order": 8, "statement": "Let $(X,\\lll,\\mm)$ be a very general triple satisfying~\\eqref{hypo}\nand assume in addition that we are in case~{\\rm\\ref{caseC1}}.\\\n Then one of the following  statements holds:\n\\begin{enumerate}[{\\rm (a)}]\n       \\item  $H^0(X,L)\\ne 0$, $H^0(X,M)\\ne 0$, and  there is a Lagrangian fibration \\mbox{$f\\colon X\\to\\P^2$} with $f^*{\\cO_{\\P^2}}(1)\\isom L$ or $M$;\n\n    \\item  at least one of $H^0(X,L)$ or $H^0(X,M)$ is trivial and  the image of the rational map $\\phi_{L\\otimes M}\\colon X\\dra \\P^5$ is rationally connected.\n\n\\end{enumerate}", "uses": [], "sources": ["riemann-roch-polynomials-hyperkahler-fourfolds"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "ffd28fb49a4d"}, {"id": "prop:CaseC2", "type": "proposition", "title": "prop:CaseC2", "chapter": "On the SYZ conjecture in dimension 4", "group": "ch:On the SYZ conjecture in dimension 4", "level": "medium", "order": 9, "statement": "Let $(X,\\lll,\\mm)$ be a very general triple\nsatisfying~\\eqref{hypo} and assume in addition that we are in case~{\\rm\\ref{caseC2}}.\\\n There exist a positive integer~$k_L$ and a Lagrangian fibration \\mbox{$f\\colon X\\to\\P^2$} such that $f^*{\\cO_{\\P^2}}(1)\\isom L^{\\otp {k_L}}$.", "uses": [], "sources": ["riemann-roch-polynomials-hyperkahler-fourfolds"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "505911847348"}, {"id": "thm:OGrady", "type": "proposition", "title": "thm:OGrady", "chapter": "Proofs of the main theorems", "group": "ch:Proofs of the main theorems", "level": "medium", "order": 17, "statement": "Let $(X,\\lll,\\mm)$ be a very general triple satisfying~\\eqref{hypo} with $\\mm$ isotropic and $\\lll$ nef.\\\nThen $X$ is isomorphic to $\\M_0(\\Sigma)$.\\\nIn particular, $X$ is of $\\mathrm{K3}^{[2]}$ deformation type.", "uses": [], "sources": ["riemann-roch-polynomials-hyperkahler-fourfolds"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "b42417a3745a"}, {"id": "prop:CaseB'2", "type": "proposition", "title": "prop:CaseB'2", "chapter": "The case of two nef isotropic classes", "group": "ch:The case of two nef isotropic classes", "level": "medium", "order": 12, "statement": "If  either $H^0(X,L)=0$ or $H^0(X,M)=0$, the image of the rational map $\\phi_{L\\otimes M}\\colon X\\dra \\P^5$ is rationally connected.", "uses": [], "sources": ["riemann-roch-polynomials-hyperkahler-fourfolds"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "7a4f8e396363"}, {"id": "prop6.3precise", "type": "proposition", "title": "prop6.3precise", "chapter": "The case of two nef isotropic classes", "group": "ch:The case of two nef isotropic classes", "level": "medium", "order": 13, "statement": "If   $H^0(X,L)=0$ and $\\dim (Y)=4$, a plane section $C_{0,W_3}$ of $Y$ defined by a general vector subspace $W_3\\subset H^0(X,L\\otimes M)$ of dimension $3$   is either  of geometric genus~$0$ or  a smooth cubic curve.", "uses": [], "sources": ["riemann-roch-polynomials-hyperkahler-fourfolds"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "d599f73bce85"}, {"id": "prop:NoFibersDimension2", "type": "proposition", "title": "prop:NoFibersDimension2", "chapter": "The divisorial contraction case", "group": "ch:The divisorial contraction case", "level": "medium", "order": 15, "statement": "The fibers of the contraction $c\\colon X\\to Y$ all have dimension at most~$ 1$, the varieties $E$ and $\\Sigma$ are smooth, and the restriction $c_E:=c\\vert_E\\colon E\\to \\Sigma$ is a $\\P^1$-fibration.", "uses": [], "sources": ["riemann-roch-polynomials-hyperkahler-fourfolds"], "lean_name": null, "proved": false, "mathlib_ok": false, "lean_status": "empty", "state": "ready", "unlocks": 0, "lean_source": null, "has_sorry": false, "lean_file": null, "dep_count": 0, "rdep_count": 0, "descendant_count": 0, "comment_count": 0, "review_count": 0, "hgraph_id": "53ec5eea0041"}], "edges": [], "dangling": [], "meta": {"engine": "hgraph", "entry": "/home/axel/LeanAlgebraicGeometry-Horizon/FormalizedPapers/SurfacesBirationalHyperkahler/RiemannRochPolynomialsHyperkahlerFourfolds/blueprint/src/content.tex", "macros": {"\\label": "", "\\source": "", "\\dcref": "", "\\uses": "", "\\lean": "", "\\leanok": "", "\\mathlibok": "", "\\notready": "", "\\Spec": "\\operatorname{Spec}", "\\Pic": "\\operatorname{Pic}", "\\Jac": "\\operatorname{Jac}", "\\GL": "\\operatorname{GL}", "\\Hom": "\\operatorname{Hom}", "\\End": "\\operatorname{End}", "\\C": "\\mathbb{C}", "\\Q": "\\mathbb{Q}", "\\Z": "\\mathbb{Z}", "\\F": "\\mathbb{F}", "\\P": "\\mathbb{P}", "\\A": "\\mathbb{A}", "\\M": "\\mathcal{M}", "\\T": "\\mathbb{G}_m", "\\K": "\\mathcal{K}", "\\Alb": "\\operatorname{Alb}", "\\Amp": "\\operatorname{Amp}", "\\Aut": "\\operatorname{Aut}", "\\Bir": "\\operatorname{Bir}", "\\Bl": "\\operatorname{Bl}", "\\Br": "\\operatorname{Br}", "\\ch": "\\operatorname{ch}", "\\CH": "\\operatorname{CH}", "\\cl": "\\operatorname{cl}", "\\Cl": "\\operatorname{Cl}", "\\CG": "\\operatorname{\\mathsf{CG}}", "\\CKGr": "\\operatorname{\\mathsf{C}_K\\mathsf{Gr}}", "\\coh": "\\operatorname{coh}", "\\cod": "\\operatorname{cod}", "\\codim": "\\operatorname{codim}", "\\Cone": "\\operatorname{Cone}", "\\Coker": "\\operatorname{Coker}", "\\coker": "\\operatorname{Coker}", "\\corank": "\\op