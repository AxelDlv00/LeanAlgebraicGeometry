@Over.crossBaseIso : {S' S : Scheme} →
  (f : S' ⟶ S) → (X : Over S) → (T : Over S') → ((Over.pullback f).obj X ⊗ T).left ≅ (X ⊗ (Over.map f).obj T).left
@Over.crossBaseIso_hom_fst : ∀ {S' S : Scheme} (f : S' ⟶ S) (X : Over S) (T : Over S'),
  (Over.crossBaseIso f X T).hom ≫ Over.Hom.left (fst X ((Over.map f).obj T)) =
    Over.Hom.left (fst ((Over.pullback f).obj X) T) ≫ pullback.fst X.hom f
